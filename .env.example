# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=30
MAX_REGENERATIONS=1
LLM_CACHE=on
LLM_CACHE_DIR=.cache/llm
DB_PATH=.data/alibi.db
INTENT_MODEL_PATH=models/intent.joblib
